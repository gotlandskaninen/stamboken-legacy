#!/bin/sh
# Type errors in src/, one line each (multi-line diagnostics joined) and
# without line and column, sorted, so CI can diff them against
# tsc-baseline.txt and catch new errors that moved code would hide.
set -e
out=$(mktemp)
status=0
node_modules/.bin/tsc --noEmit --pretty false -p . > "$out" || status=$?
# 2 means type errors were found; any other failure is a crash.
if [ "$status" -ne 0 ] && [ "$status" -ne 2 ]; then
  cat "$out" >&2
  echo "tsc failed with exit status $status" >&2
  exit 1
fi
awk '/^[^ ]/ { if (r != "") print r; r = $0; next }
     { sub(/^ +/, ""); r = r " | " $0 }
     END { if (r != "") print r }' "$out" |
  grep "^src/.*error TS" | sed -E 's/^([^:]+)\([0-9]+,[0-9]+\):/\1:/' | LC_ALL=C sort
rm -f "$out"
