#!/bin/sh -eu
# Regenerates package-lock.json from package.json in a container, without
# running install scripts. npm with --legacy-peer-deps drops vis-network's
# peer entries, so those are carried over from the previous lockfile.

docker run --rm -u "$(id -u):$(id -g)" -e HOME=/tmp -v "$PWD":/w -w /w \
    node:24-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205 \
    sh -euc '
cp package-lock.json /tmp/old.json
npm install --package-lock-only --ignore-scripts --legacy-peer-deps --no-audit --no-fund
node -e "
const fs = require(\"fs\");
const old = require(\"/tmp/old.json\").packages;
const lock = JSON.parse(fs.readFileSync(\"package-lock.json\"));
for (const name of [\"@egjs/hammerjs\", \"@types/hammerjs\", \"keycharm\", \"uuid\"]) {
  const key = \"node_modules/\" + name;
  if (!lock.packages[key] && old[key]) lock.packages[key] = old[key];
}
const keys = Object.keys(lock.packages).sort((a, b) => (a < b ? -1 : a > b ? 1 : 0));
lock.packages = Object.fromEntries(keys.map((k) => [k, lock.packages[k]]));
fs.writeFileSync(\"package-lock.json\", JSON.stringify(lock, null, 2) + \"\n\");
"
'
